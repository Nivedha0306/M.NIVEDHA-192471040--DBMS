CREATE TABLE Product (
    Product_ID INT PRIMARY KEY,
    SKU VARCHAR(20) UNIQUE NOT NULL,
    Product_Name VARCHAR(100) NOT NULL,
    Category_ID INT,
    Unit_Price DECIMAL(10,2),
    Reorder_Level INT
);
