CREATE TABLE Sale_Item (
    Sale_Item_ID INT PRIMARY KEY,
    Sale_ID INT,
    Product_ID INT,
    Quantity INT,
    Unit_Price DECIMAL(10,2),

    FOREIGN KEY (Sale_ID)
        REFERENCES Sale(Sale_ID),

    FOREIGN KEY (Product_ID)
        REFERENCES Product(Product_ID)
);
