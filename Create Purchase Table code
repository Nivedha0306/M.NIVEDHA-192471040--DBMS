CREATE TABLE Purchase (
    Purchase_ID INT PRIMARY KEY,
    Supplier_ID INT,
    Purchase_Date DATE,
    Total_Amount DECIMAL(10,2),
    FOREIGN KEY (Supplier_ID)
        REFERENCES Supplier(Supplier_ID)
);
